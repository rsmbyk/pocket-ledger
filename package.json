{
	"name": "pocket-ledger",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"workspaces": ["apps/web", "apps/api"],
	"scripts": {
		"dev": "npm run dev -w @pocket-ledger/web",
		"dev:api": "npm run dev -w @pocket-ledger/api",
		"build": "npm run build -w @pocket-ledger/web",
		"preview": "npm run preview -w @pocket-ledger/web",
		"prepare": "npm run prepare -w @pocket-ledger/web",
		"check": "npm run check -w @pocket-ledger/web && npm run check -w @pocket-ledger/api",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"icons": "node scripts/generate-icons.mjs",
		"test:unit": "npm run test:unit -w @pocket-ledger/web",
		"test:unit:run": "npm run test:unit:run -w @pocket-ledger/web",
		"test:e2e": "playwright test",
		"test": "npm run test:unit:run && npm run test:e2e"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@types/node": "^24.13.3",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0"
	}
}
