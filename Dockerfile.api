# Hono API stub for Cloud Run (Spec 118: health only).
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
RUN npm ci --omit=dev --workspace=@pocket-ledger/api --include-workspace-root
COPY apps/api apps/api
ENV PORT=8080
EXPOSE 8080
CMD ["npm", "run", "start", "-w", "@pocket-ledger/api"]
